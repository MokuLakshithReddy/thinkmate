# ==============================================================================
# ThinkMate — Environment Configuration
# ==============================================================================
# Local development: copy to .env.local. Only the Gemini/Supabase values are needed;
# the rate limiter and token-rotation key fall back to dev defaults.
# Production: every variable marked [PROD REQUIRED] must be set. Validate before release:
#   npx tsx --env-file=<your env file> scripts/check-production-env.ts --ping
# See "Deployment Checklist" in README.md.

# --- AI provider [PROD REQUIRED] ----------------------------------------------
# Google Gemini API key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
# Optional alias, used only when GEMINI_API_KEY is unset
# GOOGLE_API_KEY=

# --- Supabase auth & persistence [PROD REQUIRED] -------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
# Server-only. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# --- Canonical application URL [PROD REQUIRED] ---------------------------------
# Public https origin of the app. Used for CSRF Origin checks on login/signup and
# cookie-authenticated mutations (requests must match the Host or a configured origin).
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Server-side canonical origin; set this in production if it differs from NEXT_PUBLIC_APP_URL
# APP_URL=https://thinkmate.example.com
# Extra origins allowed to send mutations (comma-separated origins or hosts, no wildcards),
# e.g. a custom domain plus a staging alias
# TRUSTED_ORIGINS=https://thinkmate.example.com,https://staging.thinkmate.example.com

# --- Distributed rate limiting [PROD REQUIRED] ---------------------------------
# Upstash Redis REST credentials (console.upstash.com -> database -> REST API).
# In production, login/signup/refresh return 503 when these are missing or Redis is unreachable.
# UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token
# Non-auth routes fail closed in production by default. "false" allows per-instance memory
# limits during a Redis outage (emergency only; auth routes always fail closed).
# RATE_LIMIT_FAIL_CLOSED=true

# --- Token-rotation encryption [PROD REQUIRED] ---------------------------------
# Dedicated secret (>= 32 bytes) shared by all instances; encrypts rotated sessions in Redis.
# Generate with: openssl rand -base64 48
# SESSION_ENCRYPTION_KEY=

# --- Client IP / proxy trust (rate-limit keys) ---------------------------------
# Default: client IP = rightmost X-Forwarded-For entry (correct on Vercel).
# Header your edge proxy sets with the real client IP; when set, only this header is used.
# TRUSTED_PROXY_HEADER=x-real-ip
# cloudflare (cf-connecting-ip) | nginx | custom (x-real-ip)
# TRUSTED_PROXY_PROVIDER=
# Number of trusted proxies appending to X-Forwarded-For (counted from the right)
# TRUSTED_PROXY_DEPTH=1
# "false" ignores proxy headers entirely (all clients share one rate-limit bucket)
# TRUST_PROXY=true

# --- Staging verification only (scripts/verify-supabase-staging.ts) -------------
# Never set these in production: session revocation prefers them over the main project.
# STAGING_SUPABASE_URL=
# STAGING_SUPABASE_ANON_KEY=
# STAGING_SUPABASE_SERVICE_ROLE_KEY=
# EXPECTED_STAGING_PROJECT_REF=

# --- Browser end-to-end tests (npm run test:e2e) --------------------------------
# Unset: Playwright starts `next dev` locally and mocks Supabase/Gemini responses.
# Set to run the staging smoke suite against a deployed app with a real test account.
# E2E_BASE_URL=https://staging.thinkmate.example.com
# E2E_TEST_EMAIL=
# E2E_TEST_PASSWORD=
